# Downloaded sequence files. These are large and keep their own licence, so they are never committed.
data/

# Whole-study metadata tables (80,892 rows each). Too large for git; the files that
# describe them are in metadata/ and are committed.
metadata/*/full_study_tables/

# Files Jupyter creates by itself
.ipynb_checkpoints/

# Files Python creates by itself
__pycache__/

# Internal planning notes, never committed
info.md

# Internal report figure and proposed text, never committed
report/

# final/: Galaxy's local storage, the API key and large result files are not committed
final/galaxy_storage/
final/galaxy_api_key.txt
final/galaxy_invocation.txt
final/tool_test_output.*
final/results/**/*.bam
final/.venv/
